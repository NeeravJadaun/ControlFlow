# Copy to .env and adjust as needed. All values below are safe demo defaults.

# --- Postgres ---
POSTGRES_USER=controlflow
POSTGRES_PASSWORD=controlflow
POSTGRES_DB=controlflow
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+psycopg://controlflow:controlflow@db:5432/controlflow
REDIS_URL=redis://redis:6379/0
SECRET_KEY=demo-secret-key-not-for-production-use-only-synthetic-data
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DEMO_SEED=20240101
LOG_LEVEL=INFO
BACKEND_PORT=8000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
